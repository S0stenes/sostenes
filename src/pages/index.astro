---
import Layout from '../layouts/Layout.astro';
import CloudField from '../components/CloudField.astro';
import CloudCurtain from '../components/CloudCurtain.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Portfolio from '../components/Portfolio.astro';
import Contact from '../components/Contact.astro';
import RevealScript from '../components/RevealScript.astro';
import FlyingTextScript from '../components/FlyingTextScript.astro';
import TiltScript from '../components/TiltScript.astro';
import { site } from '../data/site';
---

<Layout title={site.title} description={site.description}>
	<CloudField />
	<Nav />

	<main class="relative z-10">
		<!-- hero → as nuvens abrem → sobre -->
		<CloudCurtain runway={230} travel={95}>
			<Hero slot="front" />
			<About slot="behind" />
		</CloudCurtain>

		<Skills />
		<Portfolio />
		<Contact />
	</main>

	<RevealScript />
	<FlyingTextScript />
	<TiltScript />
</Layout>
