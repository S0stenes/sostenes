---
import { nav } from '../data/site';
---

<header class="nav-bar fixed inset-x-0 top-0 z-50">
	<nav class="flex justify-center py-2.5 sm:py-3" aria-label="Main">
		<ul class="flex items-center gap-4 sm:gap-8">
			{
				nav.map((item) => (
					// px/py generosos: a área de toque fica ≥44px mesmo com a fonte pequena
					<li>
						<a
							href={item.href}
							class="inline-flex min-h-11 items-center px-3 text-[1rem] text-graphite-700 transition-colors hover:text-graphite-900 sm:px-4 sm:text-[1.05rem]"
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	/* véu suave sob o menu: o conteúdo que passa por baixo não briga com os links,
	   e a barra não vira um retângulo duro sobre as nuvens */
	.nav-bar::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		background: linear-gradient(
			180deg,
			rgb(255 255 255 / 0.72) 0%,
			rgb(255 255 255 / 0.5) 55%,
			rgb(255 255 255 / 0) 100%
		);
		-webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
		mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
	}
</style>
