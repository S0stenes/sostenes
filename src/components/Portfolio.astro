---
import { Image } from 'astro:assets';
import { projects } from '../data/site';
---

<section id="portfolio" class="portfolio relative z-10 overflow-x-clip py-14 sm:py-20">
	<ul class="space-y-12 sm:space-y-6">
		{
			projects.map((project, i) => (
				<li
					class:list={[
						'flex flex-col items-center gap-4 sm:flex-row sm:gap-8',
						project.side === 'right' && 'sm:flex-row-reverse',
					]}
				>
					{/* a imagem entra deslizando do lado em que ela vive */}
					<div
						class:list={[
							'tilt-wrap w-full px-5 sm:w-[42%] sm:px-0',
							project.side === 'left' ? 'sm:-ml-[6%]' : 'sm:-mr-[6%]',
						]}
						data-reveal
						data-from={project.side}
						style={`--reveal-delay: ${i * 0.05}s;`}
					>
						<a
							href={project.url}
							target="_blank"
							rel="noopener noreferrer"
							class:list={[
								'tilt group relative block overflow-hidden rounded-2xl shadow-[0_10px_30px_-12px_rgb(40_50_70/0.28)]',
								project.side === 'left' ? 'sm:rounded-l-none' : 'sm:rounded-r-none',
							]}
							data-tilt
							data-tilt-max="9"
							tabindex="-1"
							aria-hidden="true"
						>
							<Image
								src={project.image}
								alt=""
								widths={[480, 720, 1080]}
								sizes="(max-width: 639px) 100vw, 42vw"
								loading="lazy"
								decoding="async"
								class="aspect-[16/10] w-full object-cover object-top"
							/>
							{/* reflexo que segue o cursor, como luz numa superfície */}
							<span class="tilt__glare" aria-hidden="true" />
						</a>
					</div>

					{/* o nome sobe com um respiro depois da imagem */}
					<div
						class="flex w-full flex-col items-center px-6 text-center sm:w-[58%]"
						data-reveal
						style={`--reveal-y: 22px; --reveal-delay: ${i * 0.05 + 0.16}s;`}
					>
						<a
							href={project.url}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-block px-3 py-2 text-[1.25rem] text-graphite-900 underline-offset-8 transition-colors hover:underline sm:text-[1.3rem]"
						>
							{project.name}
						</a>
						<p class="mt-1 max-w-[34ch] text-[0.95rem] leading-relaxed text-balance text-graphite-500">
							{project.summary}
						</p>
					</div>
				</li>
			))
		}
	</ul>
</section>

<style>
	/* a perspectiva vive no pai; sem ela a rotação parece só um achatamento */
	.tilt-wrap {
		perspective: 900px;
	}

	.tilt {
		--rx: 0deg;
		--ry: 0deg;
		--gx: 50%;
		--gy: 50%;
		transform: rotateX(var(--rx)) rotateY(var(--ry));
		transform-style: preserve-3d;
		/* na saída volta devagar; durante o movimento o JS manda direto */
		transition:
			transform 600ms cubic-bezier(0.22, 0.61, 0.36, 1),
			box-shadow 400ms ease;
	}

	.tilt.is-tilting {
		/* enquanto segue o cursor a resposta é quase imediata */
		transition:
			transform 90ms linear,
			box-shadow 400ms ease;
		box-shadow: 0 26px 50px -20px rgb(30 40 60 / 0.42);
	}

	.tilt__glare {
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0;
		transition: opacity 350ms ease;
		background: radial-gradient(
			circle at var(--gx) var(--gy),
			rgb(255 255 255 / 0.32) 0%,
			rgb(255 255 255 / 0.08) 32%,
			transparent 62%
		);
	}

	.tilt.is-tilting .tilt__glare {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.tilt {
			transform: none !important;
			transition: none;
		}
		.tilt__glare {
			display: none;
		}
	}

	/* direção da entrada por lado — em CSS, não inline, para poder
	   neutralizar no mobile, onde 56px de deslize é exagero numa tela de 320px */
	.portfolio [data-from='left'] {
		--reveal-x: -56px;
	}

	.portfolio [data-from='right'] {
		--reveal-x: 56px;
	}

	@media (max-width: 639px) {
		.portfolio [data-from] {
			--reveal-x: 0px;
			--reveal-y: 26px;
		}
	}
</style>
