---
import { nav, site } from '../data/site';
---

<header class="sticky top-0 z-50 border-b border-white/5 bg-ink-950/80 backdrop-blur-md">
	<nav
		class="mx-auto flex max-w-5xl items-center justify-between gap-6 px-6 py-4"
		aria-label="Navegação principal"
	>
		<a
			href="#topo"
			class="shrink-0 text-sm font-semibold tracking-tight text-ink-50 transition-colors hover:text-accent"
		>
			{site.shortName}
		</a>

		<ul class="flex items-center gap-4 sm:gap-6">
			{
				nav.map((item) => (
					<li>
						<a
							href={item.href}
							class="text-xs text-ink-300 transition-colors hover:text-ink-50 sm:text-sm"
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
