---
interface Props {
	icon: 'github' | 'x' | 'instagram' | 'linkedin';
	class?: string;
}

const { icon, class: className } = Astro.props;
---

{
	icon === 'github' && (
		<svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
			<path d="M12 .5C5.73.5.9 5.4.9 11.75c0 4.97 3.16 9.18 7.55 10.67.55.1.75-.24.75-.54v-1.9c-3.07.68-3.72-1.32-3.72-1.32-.5-1.31-1.23-1.66-1.23-1.66-1-.7.08-.68.08-.68 1.11.08 1.7 1.16 1.7 1.16.99 1.72 2.6 1.22 3.23.94.1-.73.39-1.23.7-1.51-2.45-.28-5.02-1.24-5.02-5.53 0-1.22.43-2.22 1.13-3-.11-.28-.49-1.42.11-2.96 0 0 .93-.3 3.05 1.15a10.4 10.4 0 0 1 5.56 0c2.12-1.45 3.05-1.15 3.05-1.15.6 1.54.22 2.68.11 2.96.7.78 1.13 1.78 1.13 3 0 4.3-2.58 5.25-5.03 5.52.4.35.75 1.03.75 2.08v3.08c0 .3.2.65.76.54a11.28 11.28 0 0 0 7.54-10.67C23.1 5.4 18.27.5 12 .5Z" />
		</svg>
	)
}
{
	icon === 'x' && (
		<svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
			<path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.22-6.82-5.96 6.82H1.68l7.73-8.84L1.25 2.25h6.82l4.71 6.23 5.46-6.23Zm-1.16 17.52h1.83L7.01 4.13H5.05l12.03 15.64Z" />
		</svg>
	)
}
{
	icon === 'instagram' && (
		<svg
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.8"
			class={className}
			aria-hidden="true"
		>
			<rect x="2.5" y="2.5" width="19" height="19" rx="5.4" />
			<circle cx="12" cy="12" r="4.6" />
			<circle cx="17.6" cy="6.4" r="1.2" fill="currentColor" stroke="none" />
		</svg>
	)
}
{
	icon === 'linkedin' && (
		<svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
			<path d="M20.45 2H3.55C2.7 2 2 2.68 2 3.52v16.96C2 21.32 2.7 22 3.55 22h16.9c.85 0 1.55-.68 1.55-1.52V3.52C22 2.68 21.3 2 20.45 2ZM8.34 18.75H5.4V9.4h2.94v9.35ZM6.87 8.11a1.7 1.7 0 1 1 0-3.4 1.7 1.7 0 0 1 0 3.4Zm11.88 10.64h-2.94v-4.55c0-1.08-.02-2.48-1.51-2.48-1.52 0-1.75 1.18-1.75 2.4v4.63H9.61V9.4h2.82v1.28h.04c.4-.74 1.35-1.52 2.79-1.52 2.98 0 3.53 1.96 3.53 4.51v5.08Z" />
		</svg>
	)
}
