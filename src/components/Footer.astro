---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/5">
	<div
		class="mx-auto flex max-w-5xl flex-col gap-2 px-6 py-8 text-sm text-ink-500 sm:flex-row sm:items-center sm:justify-between"
	>
		<p>© {year} {site.name}</p>
		<p>
			Feito com <a
				href="https://astro.build"
				target="_blank"
				rel="noopener noreferrer"
				class="transition-colors hover:text-ink-50">Astro</a
			>
		</p>
	</div>
</footer>
