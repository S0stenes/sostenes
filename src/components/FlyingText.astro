---
/**
 * FlyingText — ao passar o mouse, as letras se soltam e voam pela tela,
 * depois voltam ao lugar.
 *
 *   <FlyingText text="Core: HTML5, CSS3" as="span" />
 *
 * Cada letra vira um <span> próprio, movido só por `transform` — que não
 * afeta o layout, então as letras voam sem empurrar nada.
 *
 * IMPORTANTE: o HTML é montado como string única e injetado com set:html.
 * Se as tags fossem geradas por .map() no template, o Astro colocaria uma
 * quebra de linha entre cada <span>, e entre elementos inline-block todo
 * espaço em branco do código VIRA UM ESPAÇO NA TELA — o texto sairia
 * "C S S  F r a m e w o r k s".
 *
 * Acessibilidade: o pai carrega o texto inteiro em aria-label e as letras
 * ficam aria-hidden, senão o leitor de tela soletraria "C… S… S…".
 */

interface Props {
	text: string;
	as?: 'span' | 'h2' | 'h3' | 'p';
	class?: string;
	/** distância máxima do voo, em px */
	spread?: number;
	/** duração da ida (a volta usa o dobro) */
	duration?: number;
}

const {
	text,
	as: Tag = 'span',
	class: className,
	spread = 190,
	duration = 480,
} = Astro.props;

const escapar = (c: string) =>
	c === '&' ? '&amp;' : c === '<' ? '&lt;' : c === '>' ? '&gt;' : c;

// string única, sem nenhum espaço em branco entre as tags
const letras = [...text]
	.map((c) =>
		c === ' '
			? '<span class="fly__sp" aria-hidden="true">&nbsp;</span>'
			: `<span class="fly__c" aria-hidden="true">${escapar(c)}</span>`
	)
	.join('');
---

<Tag
	class:list={['fly', className]}
	data-fly
	data-fly-spread={spread}
	data-fly-duration={duration}
	aria-label={text}
	set:html={letras}
/>

<style>
	.fly {
		cursor: default;
		/* as letras saem da caixa: sem isso elas seriam cortadas */
		overflow: visible;
	}

	.fly__c,
	.fly__sp {
		/* no repouso as letras são inline: preservam o encaixe natural da fonte.
		   O JS troca para inline-block só na hora de voar, porque transform
		   não se aplica a elementos inline. */
		display: inline;
		--tx: 0px;
		--ty: 0px;
		--rot: 0deg;
		--sc: 1;
	}

	.fly.is-active .fly__c,
	.fly.is-active .fly__sp {
		display: inline-block;
	}

	.fly.is-active .fly__c {
		transform: translate3d(var(--tx), var(--ty), 0) rotate(var(--rot)) scale(var(--sc));
		transition:
			transform var(--dur, 480ms) cubic-bezier(0.34, 1.3, 0.64, 1),
			opacity var(--dur, 480ms) ease;
		will-change: transform;
	}

	@media (prefers-reduced-motion: reduce) {
		.fly.is-active .fly__c {
			transform: none !important;
			opacity: 1 !important;
			transition: none;
		}
	}
</style>
