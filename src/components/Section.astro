---
interface Props {
	id: string;
	title: string;
	eyebrow?: string;
}

const { id, title, eyebrow } = Astro.props;
---

<section id={id} class="mx-auto max-w-5xl scroll-mt-20 px-6 py-16 sm:py-20">
	<div class="mb-10 border-b border-white/5 pb-6">
		{
			eyebrow && (
				<p class="mb-2 text-xs font-medium tracking-widest text-accent uppercase">
					{eyebrow}
				</p>
			)
		}
		<h2 class="text-2xl font-semibold tracking-tight text-ink-50 sm:text-3xl">
			{title}
		</h2>
	</div>

	<slot />
</section>
