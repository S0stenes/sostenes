---
import Section from './Section.astro';
import { stack } from '../data/site';
---

<Section id="stack" title="Stack" eyebrow="03">
	<dl class="grid gap-8 sm:grid-cols-2">
		{
			stack.map((group) => (
				<div>
					<dt class="mb-3 text-sm font-medium text-ink-500">{group.group}</dt>
					<dd>
						<ul class="flex flex-wrap gap-2">
							{group.items.map((item) => (
								<li class="rounded-md border border-white/8 px-2.5 py-1 font-mono text-sm text-ink-50">
									{item}
								</li>
							))}
						</ul>
					</dd>
				</div>
			))
		}
	</dl>
</Section>
